    {
        "id": "store_iot_data",
        "type": "function",
        "z": "tab_iot_monitor",
        "name": "Simpan data & normalisasi",
        "func": "// Normalisasi payload dari ESP32 atau Simulasi Inject.\nconst p = msg.payload || {};\nconst sourceMode = flow.get(\"source_mode\") || \"simulation\";\n\n// Deteksi apakah data berasal dari simulasi inject\nconst isSim = (p.device_id === \"ESP32-SIMULATOR\" || msg._source === \"simulation\");\n\n// Filter berdasarkan mode aktif dari slider dashboard\nif (sourceMode === \"esp\" && isSim) {\n    return null; // Abaikan simulasi saat mode Real ESP32 dipilih\n}\nif (sourceMode === \"simulation\" && !isSim) {\n    return null; // Abaikan data ESP saat mode Simulasi dipilih\n}\n\n// Variasi dinamis halus untuk data simulasi\nlet temp = Number(p.temperature ?? p.temp ?? p.suhu ?? p.t);\nlet hum = Number(p.humidity ?? p.hum ?? p.kelembapan ?? p.kelembaban ?? p.h);\nif (isSim && Number.isFinite(temp) && Number.isFinite(hum)) {\n    temp = Number((temp + (Math.random() * 0.8 - 0.4)).toFixed(1));\n    hum = Number((hum + (Math.random() * 1.6 - 0.8)).toFixed(1));\n}\n\nif (!isSim) {\n    node.warn(\"[MQTT ESP32 DITERIMA] Topik: \" + msg.topic + \" -> Suhu: \" + temp + \", Kelembapan: \" + hum);\n}\n\nconst row = {\n    device_id: isSim ? \"ESP32-SIMULATOR\" : (p.device_id ?? p.deviceId ?? \"esp32-hary\"),\n    timestamp: p.timestamp ?? p.time ?? new Date().toISOString(),\n    temperature: temp,\n    humidity: hum,\n    rule_anomaly: p.rule_anomaly ?? p.anomaly_rule ?? p.rule ?? \"normal\",\n    ai_score: Number(p.ai_score ?? p.anomaly_score ?? (isSim ? (Math.random() * 0.12).toFixed(3) : 0)),\n    status: p.status ?? p.anomaly_status ?? \"normal\",\n    source: isSim ? \"simulation\" : \"esp\"\n};\n\nif (!Number.isFinite(row.temperature) || !Number.isFinite(row.humidity)) {\n    node.warn(\"Payload tidak memiliki temperature/humidity numerik: \" + JSON.stringify(p));\n    return null;\n}\n\nlet history = flow.get(\"iot_history\") || [];\nhistory.unshift(row);\nhistory = history.slice(0, 100);\nflow.set(\"iot_history\", history);\nflow.set(\"iot_latest\", row);\nmsg.payload = row;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 100,
        "wires": [
            []
        ]
    },
