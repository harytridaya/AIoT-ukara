        "type": "function",
        "z": "tab_iot_monitor",
        "name": "Ambil data terakhir",
        "func": "const latest = flow.get(\"iot_latest\") || null;\nconst mode = flow.get(\"source_mode\") || \"simulation\";\nmsg.statusCode = 200;\nmsg.headers = { \"Content-Type\": \"application/json; charset=utf-8\", \"Cache-Control\": \"no-store\" };\nmsg.payload = { latest, mode };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
